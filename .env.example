APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ssu_backend
DB_USERNAME=root
DB_PASSWORD=

# Per-store storefront routing. In dev: base domain "localhost", cookies shared
# across *.localhost. In prod: set these to your apex domain (e.g. yoursite.com,
# .yoursite.com, and SANCTUM "*.yoursite.com,yoursite.com").
#
# Custom domains per store (e.g. nazareck.com, touchme.com) are stored in the
# store_domains table and resolved automatically by the middleware. For custom
# domains, set SANCTUM_STATEFUL_DOMAINS to the actual domain(s) or use a
# catch-all approach (serving FE + API from the same origin).
STOREFRONT_BASE_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=*.localhost:3000,localhost:3000,127.0.0.1:3000,*.localhost:8000,localhost:8000,127.0.0.1:8000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.localhost

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Reverb WebSocket Server
# IMPORTANT: Generate unique credentials for production (e.g. use `openssl rand -hex 16`)
REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
# Production: use https and configure TLS at reverse proxy or Reverb level
# REVERB_SCHEME=https
# REVERB_PORT=443

# Reverb Limits (defaults are production-safe, override if needed)
# REVERB_APP_MAX_CONNECTIONS=10000
# REVERB_APP_RATE_LIMITING_ENABLED=true
# REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=30

# Reverb Scaling (enable when running multiple Reverb instances)
# REVERB_SCALING_ENABLED=true

REALTIME_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Admin help assistant (Google Gemini — free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
