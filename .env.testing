# Test-only env. Laravel auto-loads this when APP_ENV=testing (which `php
# artisan test` and PHPUnit set). Keeping the test DB on sqlite in-memory
# guarantees that `RefreshDatabase` can NEVER touch the live MySQL DB —
# regardless of phpunit.xml `<env force=...>` precedence quirks.
APP_NAME=ssu-test
APP_ENV=testing
APP_KEY=base64:IeIUR/Hy/O07uNIAiw/R3IrRreGYAG9EJKfNbMbLu1Y=
APP_DEBUG=true

APP_URL=http://localhost
BCRYPT_ROUNDS=4

# This is the line that protects your data. Do not remove.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
REALTIME_ENABLED=false
